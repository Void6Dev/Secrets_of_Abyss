			CurseOfMe: {
				// DisplayName: Curse of Me
				/* Tooltip:
					'''
					Decrease Player regeneration by 3
					If Player get damaged by enemy or projectile fire 5 projectile 
					Damage from projectiles based on Player magic damage
					Spookie
					''' */
			}

			InfernoShuriken: {
				// DisplayName: Inferno Shuriken
				/* Tooltip:
					'''
					Hold to heat the shuriken in your hand, release to throw
					An early release throws it in an arc that ricochets between nearby enemies
					Release when it flashes white-hot: it bites into the first enemy, saws it apart, tears out in an explosion and flies back
					Catching it resets the cooldown and grants Heat (up to 3): each stack widens the explosion, at full Heat it sprays molten shards
					Hold too long and it overheats: it burns your hand but pierces straight through enemies
					''' */
			}

			ClawsOfLavaShadow: {
				// DisplayName: Lava claw
				/* Tooltip:
					'''
					Rakes toward the cursor with alternating claws, every fourth strike is a heavy one
					Hits brand the enemy: the brand stores the damage and erupts once you stop attacking
					Right click to dash through fire with brief invulnerability (2 second cooldown)
					Ouch, too hot
					''' */
			}

			Tidesand: {
				// DisplayName: Tidesand
				// Tooltip: Sand of Forgotten ocean
			}

			Tidestone: {
				// DisplayName: Tidestone
				// Tooltip: Bedrock of the Forgotten ocean
			}

			StructureWand: {
				// DisplayName: Structure Wand
				/* Tooltip:
					'''
					Dev tool: saves any shape of the world into a structure file
