					''' */
			}

			ScytheOfFireStorm: {
				// DisplayName: Scythe of Fire Storm
				/* Tooltip:
					'''
					Hold to heat the blade through three stages, release to swing
					A quick swing throws a fiery crescent, a heated one unleashes a blazing tornado
					Each stage grows the tornado and costs extra mana
					The tornado travels forward, pulling enemies in and setting them ablaze
					Swing through your tornado to feed it: it burns longer and turns toward the cursor
					Launching a third tornado snuffs out the oldest one
					Touching water turns the vortex into a scalding steam geyser that hurls enemies skyward
					''' */
			}

			FlinxHood: {
				SetBonus:
					'''
					Дальность кнутов +30%
					Окутывает снежной аурой
					Дважды нажмите {0}, чтобы включить или выключить ауру
					'''
				AuraOn: Снежная аура включена
				AuraOff: Снежная аура выключена
				// DisplayName: Flinx Hood
				// Tooltip: Increases summon damage by 5%
			}

			HaloOfBreathing: {
				// DisplayName: Halo Of Breathing
				/* Tooltip:
					'''
					In a large, deep body of water you use up air three times slower
					The halo softly lights up the water around you
					''' */
			}

			HellStar: {
				// Tooltip: ""
				// DisplayName: Hell Star
			}

			RoyalClaw: {
				// DisplayName: Royal Claw
				// Tooltip: A claw fit for a king. Surely someone can forge something out of this.
			}

			Toothbreaker: {
				DisplayName: Зубодробилка
				Tooltip:
					'''
					Зажмите, чтобы занести молот над головой, отпустите — чтобы обрушить его
					Чем дольше замах, тем сильнее удар
					Полностью заряженный удар сотрясает землю и оглушает врагов
					'''
			}

			KingCrabBag: {
				DisplayName: Мешок с сокровищами (Король-краб)
				Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
			}

			CrabRoyalBait: {
				// DisplayName: Royal Bait
				/* Tooltip:
					'''
					A royal offering
					Right click the Royal Tide Altar in the sunken galleon
					with this in your inventory to summon the King Crab
					Not consumed
					''' */
			}

			AbyssArrow: {
				// DisplayName: Abyss Arrow
				/* Tooltip:
					'''
					Underwater it keeps full speed and steers toward nearby prey
					Out of water it drops fast and flies straight
					''' */
			}

			RoyalSpear: {
				DisplayName: Королевская Регалия
				Tooltip:
					'''
					Удары промачивают врагов; промокшие получают на 25% больше урона. Под водой атакует быстрее
					Клик — укол, взмах и тяжёлый выпад
					Зажмите, чтобы подготовить шквал уколов: чем дольше держите, тем больше ударов
					Зажмите ПКМ, чтобы зарядить бросок. Копьё остаётся там, куда воткнулось
					Подойдите к воткнутому копью, чтобы забрать его, или держите ПКМ, чтобы пересобрать его из песка
					Урон наполняет шкалу прилива. С полной шкалой ПКМ становится приливным рывком:
					вы проноситесь к точке над курсором и пикируете вниз вместе с копьём, оглушая цель
					'''
			}

			TideskimmerBoots: {
				// DisplayName: Tideskimmer Boots
				/* Tooltip:
					'''
					Water no longer slows you down: you move freely while submerged
					Underwater you can make one low jump before touching the bottom again
					Hold jump to build pressure, then the boots shoot you up and out of the water
					Water landings and your own launch never deal fall damage
					''' */
			}

			DepthPearl: {
				DisplayName: Жемчужина глубины
				Tooltip:
					'''
					Навсегда ослабляет давление глубины
					Полностью глубина не отпускает никогда
					Можно съесть до 4 штук
