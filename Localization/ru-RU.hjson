		Configs: {
			SoAClientConfig: {
				DisplayName: Secrets of Abyss

				ScreenShake: {
					Label: Тряска экрана
					Tooltip: Тряска камеры от оружия, взрывов и боссов мода. Выключите, если от неё укачивает.
				}

				Headers.Experimental: Экспериментальное

				ExperimentalWaterPhysics: {
					Label: Экспериментальная физика воды
					Tooltip: Инерция, плавучесть и течения в воде Прилива Теней: персонаж скользит, а не замирает, у поверхности его тянет вверх, прыжок с высоты уводит глубже, а в глубоких зонах сносит течением. Не доделано, может ощущаться странно.
				}
			}

			SoADevConfig: {
				// DisplayName: SoA Dev Tools

				EnableDevMenu: {
					// Label: Enable dev menu
					// Tooltip: Fullscreen to-do list for the mod author, opened with the tilde key. Click a line to cross it out.
				}
			}
		}

		Keybinds: {
			// DevMenu.DisplayName: Dev menu
			StructureUndo.DisplayName: Жезл построек — отмена
		}

		StructureTool: {
			Toolbar: {
				Select: {
					Title: Выделение зоны
					Description:
						'''
						Позволяет выделить область
						для копирования или
						сохранения структуры.
						'''
					LeftClick: ЛКМ – начать выделение
					RightClick: ПКМ – отмена
				}

				Add: {
					Title: Добавление к зоне
					Description:
						'''
						Дополняет уже выделенную
						зону новой областью.
						'''
					LeftClick: ЛКМ – добавить область
					RightClick: ПКМ – отмена
				}

				Erase: {
					Title: Удаление из зоны
					Description:
						'''
						Вырезает область из уже
						выделенной зоны.
						'''
					LeftClick: ЛКМ – вырезать область
					RightClick: ПКМ – отмена
				}

				Place: {
					Title: Разместить структуру
					Description:
						'''
						Открывает библиотеку построек.
						Выбранная идёт за курсором:
						СКМ отражает, красным — тайлы,
						которые она заменит.
						'''
					LeftClick: ЛКМ – библиотека / поставить
					RightClick: ПКМ – выйти из размещения
				}

				Undo: {
					Title: Отменить
					Description:
						'''
						Откатывает последнее изменение
						выделения или размещение.
						Клавиша: {0}
						'''
					LeftClick: ЛКМ – отменить
				}

				Save: {
					Title: Сохранить структуру
					Description:
						'''
						Открывает окно сохранения
						выделенной постройки.
						'''
					LeftClick: ЛКМ – открыть окно
				}
			}

			Dialog: {
				Title: Сохранить структуру
				NameLabel: Название:
				FiltersLabel: Игнорируемые тайлы:
				ToSources: Сохранить в исходники мода
				ToExport: Сохранится в папку экспорта
				Overwrite: Перезаписать
				StatsSize: Размер {0}x{1}, клеток {2}
				StatsTiles: Блоков: {0} (видов: {1})
				StatsWalls: Стен: {0}, клеток с жидкостью: {1}
				WarnChests: Сундуки сохранятся без содержимого
				WarnWires: Провода и актуаторы не сохраняются
				WarnOverwrite: Файл с таким именем уже есть
				Cancel: Отмена
				Save: Сохранить
			}

