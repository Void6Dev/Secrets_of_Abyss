		// Keybinds.DevMenu.DisplayName: Dev menu

		StructureTool: {
			Toolbar: {
				Select: {
					Title: Выделение зоны
					Description:
						'''
						Позволяет выделить область
						для копирования или
						сохранения структуры.
						'''
					LeftClick: ЛКМ – начать выделение
					RightClick: ПКМ – отмена
				}

				Add: {
					Title: Добавление к зоне
					Description:
						'''
						Дополняет уже выделенную
						зону новой областью.
						'''
					LeftClick: ЛКМ – добавить область
					RightClick: ПКМ – отмена
				}

				Erase: {
					Title: Удаление из зоны
					Description:
						'''
						Вырезает область из уже
						выделенной зоны.
						'''
					LeftClick: ЛКМ – вырезать область
					RightClick: ПКМ – отмена
				}

				Save: {
					Title: Сохранить структуру
					Description:
						'''
						Открывает окно сохранения
						выделенной постройки.
						'''
					LeftClick: ЛКМ – открыть окно
				}
			}

			Dialog: {
				Title: Сохранить структуру
				NameLabel: Название:
				FiltersLabel: Игнорируемые тайлы:
				Cancel: Отмена
				Save: Сохранить
			}

			Filters: {
				Walls: Фоновые стены
				Liquids: Жидкости
				Grass: Трава
				Cobwebs: Паутина
				Vines: Лианы
				LightSources: Освещение
			}

			Chat: {
				NothingSelected: Ничего не выделено: зажми ЛКМ и проведи мышью.
				SelectionCleared: Выделение сброшено.
				Snapped: Выделение дотянуто до целых объектов (+{0} тайлов).
				OverLimit: Выделение {0}x{1} больше предела {2}x{3}. Подрежь режимом удаления.
				EnterName: Сначала введи название.
				Saved: Сохранено {0}x{1}, {2} тайлов: {3}
			}
		}

		DevMenu: {
			Title: SoA — что нужно сделать
			Hint: ё или Esc — закрыть, клик по строке — зачеркнуть, колесо — прокрутка
			// HiddenSuffix: "  — done are hidden"
			// ShotSaved: Screenshot noted on the board: {0}
			// ShotFailed: Screenshot failed: {0}
		}
	}
