Mods: {
	SoA: {
		Items: {
			LighthouseLamp: {
				DisplayName: Лампа маяка
				Tooltip:
					'''
					Бросает луч света, который упирается в первую скалу
					Повесь под ней маячную цепь, чтобы поворачивать луч
					ПКМ — зажечь или погасить
					'''
			}

			LighthouseChain: {
				DisplayName: Маячная цепь
				Tooltip:
					'''
					Вешается под лампой маяка
					Зажми ПКМ на цепи, чтобы повернуть луч к курсору
					'''
			}

			Ichthyofang: {
				// DisplayName: Ichthyofang
				/* Tooltip:
					'''
					A barbed fang torn from the creatures of the black tide
